# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pos?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRATION="24h"

# QR Code Signing
# Tenant secrets are stored in DB, this is just default for seeding
DEFAULT_TENANT_SECRET="default-tenant-secret-for-qr-signing"

# Device Registration
DEVICE_REGISTRATION_ENABLED=true

# Server
PORT=3000
NODE_ENV=development

# Sync
SYNC_BATCH_MAX_SIZE=100
